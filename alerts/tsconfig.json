{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "../app/src/lib",
    "../app/src/config",
    "../app/src/types",
    "../app/src/i18n/locale.ts"
  ],
  "exclude": [
    "../app/src/**/*.test.ts",
    "../app/src/**/*.test.tsx",
    "../app/src/config/alerts.ts"
  ]
}
